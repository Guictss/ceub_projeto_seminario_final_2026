[run]
source = .
omit =
    tests/*
    venv/*
    migrations/*
    instance/*
    seed.py
    openapi.yaml
    */__pycache__/*
    .venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
precision = 1
show_missing = True
skip_covered = False