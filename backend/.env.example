# ═══════════════════════════════════════════════════════════════
# LOCAL / DESENVOLVIMENTO
# Copie este arquivo para `.env` e ajuste os valores.
# ═══════════════════════════════════════════════════════════════

# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=mude-esta-chave-em-producao

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=mude-esta-chave-tambem-em-producao
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# ── Banco de Dados ────────────────────────────────────────────
# Local: SQLite (recomendado)
DATABASE_URL=sqlite:///vela.db
# Produção: PostgreSQL (fornecido pelo Render automaticamente)
# DATABASE_URL=postgresql://user:password@host:port/database

# ── CORS ──────────────────────────────────────────────────────
# Local (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Produção: URLs dos frontends na Vercel
# CORS_ORIGINS=https://vela-para-todos.vercel.app,https://vela-para-todos-ceub.vercel.app


# ═══════════════════════════════════════════════════════════════
# PRODUÇÃO (Render.com) — valores definidos no painel do Render,
# NÃO neste arquivo. Lista para referência:
# ═══════════════════════════════════════════════════════════════
#
# FLASK_ENV=production
# SECRET_KEY=<gerar chave aleatoria forte, 32+ chars>
# JWT_SECRET_KEY=<gerar chave aleatoria forte, 32+ chars>
# DATABASE_URL=<auto-preenchida pelo Render ao linkar o PostgreSQL>
# CORS_ORIGINS=https://vela-para-todos.vercel.app
# PYTHON_VERSION=3.12.4
#
# Para gerar chaves aleatórias:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
